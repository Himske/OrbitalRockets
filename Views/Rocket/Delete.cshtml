@model Rocket

@{
    ViewData["Title"] = "Delete rocket";
}

<h1>Delete rocket</h1>
<p>Are you sure you want to delete this rocket? Its crews and their members will also be deleted.</p>

<dl class="row">
    <dt class="col-sm-2">Rocket name</dt>
    <dd class="col-sm-10">@Model.RocketName</dd>
    <dt class="col-sm-2">Manufacturer</dt>
    <dd class="col-sm-10">@Model.Manufacturer</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index">Back to rockets</a>
</form>
