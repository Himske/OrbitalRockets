@model RocketCrew
@{ ViewData["Title"] = "Delete crew"; }
<h1>Delete crew</h1>
<p>Are you sure you want to delete this crew? Its members will also be deleted.</p>
<dl class="row">
    <dt class="col-sm-2">Crew name</dt><dd class="col-sm-10">@Model.CrewName</dd>
    <dt class="col-sm-2">Rocket</dt><dd class="col-sm-10">@Model.Rocket?.RocketName</dd>
</dl>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index">Back to crews</a>
</form>
