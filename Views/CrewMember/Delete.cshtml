@model CrewMember
@{ ViewData["Title"] = "Delete crew member"; }
<h1>Delete crew member</h1>
<p>Are you sure you want to delete this crew member?</p>
<dl class="row">
    <dt class="col-sm-2">First name</dt><dd class="col-sm-10">@Model.FirstName</dd>
    <dt class="col-sm-2">Last name</dt><dd class="col-sm-10">@Model.LastName</dd>
    <dt class="col-sm-2">Role</dt><dd class="col-sm-10">@Model.Role</dd>
    <dt class="col-sm-2">Crew</dt><dd class="col-sm-10">@Model.RocketCrew?.CrewName</dd>
    <dt class="col-sm-2">Rocket</dt>
    <dd class="col-sm-10">
        @if (Model.RocketCrew?.Rocket is { } rocket) {
            <a asp-controller="Rocket" asp-action="Details" asp-route-id="@rocket.Id">@rocket.RocketName</a>
        }
    </dd>
</dl>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index">Back to crew members</a>
</form>
