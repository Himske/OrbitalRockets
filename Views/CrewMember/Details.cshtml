@model CrewMember
@{ ViewData["Title"] = "Crew member details"; }
<h1>Crew member details</h1>
<dl class="row">
    <dt class="col-sm-2">First name</dt><dd class="col-sm-10">@Model.FirstName</dd>
    <dt class="col-sm-2">Last name</dt><dd class="col-sm-10">@Model.LastName</dd>
    <dt class="col-sm-2">Role</dt><dd class="col-sm-10">@Model.Role</dd>
    <dt class="col-sm-2">Crew</dt><dd class="col-sm-10"><a asp-controller="RocketCrew" asp-action="Details" asp-route-id="@Model.RocketCrewId">@Model.RocketCrew?.CrewName</a></dd>
    <dt class="col-sm-2">Rocket</dt>
    <dd class="col-sm-10">
        @if (Model.RocketCrew?.Rocket is { } rocket) {
            <a asp-controller="Rocket" asp-action="Details" asp-route-id="@rocket.Id">@rocket.RocketName</a>
        }
    </dd>
</dl>
<p><a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> | <a asp-action="Index">Back to crew members</a></p>
